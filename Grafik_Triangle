5.Dewasa 20-65 tahun
import numpy as np
import matplotlib.pyplot as plt

# Rentang usia
x = np.linspace(20, 65, 500)

# Titik fungsi segitiga
a = 20
b = 42.5
c = 65

# Membuat nilai awal derajat keanggotaan
y = np.zeros_like(x)

# Sisi naik
kiri = (x > a) & (x <= b)
y[kiri] = (x[kiri] - a) / (b - a)

# Sisi turun
kanan = (x > b) & (x < c)
y[kanan] = (c - x[kanan]) / (c - b)

# Titik puncak
y[x == b] = 1

# Membuat grafik
plt.figure(figsize=(8, 5))

plt.plot(x, y, linewidth=2)

# Judul dan label
plt.title("Fungsi Keanggotaan Dewasa")
plt.xlabel("Usia (tahun)")
plt.ylabel("Derajat Keanggotaan μ(x)")

# Batas grafik
plt.xlim(20, 65)
plt.ylim(0, 1.1)

# Grid
plt.grid(True)

# Menampilkan grafik
plt.show()

